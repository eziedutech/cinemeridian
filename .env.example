# CineMeridian - environment template
#
# Copy the values you need into credentials/gcp.env and credentials/clickhouse.env
# (both gitignored) for local work. On Cloud Run these arrive from Secret Manager.
# Never commit a filled-in copy of this file.

# --- Google Cloud / Vertex AI ---------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GCS_ASSET_BUCKET=your-asset-bucket
CINEMERIDIAN_MODEL=gemini-3.7-flash
# Gemini 3 is served from `global` and the `us`/`eu` multi-regions, not from a
# plain regional endpoint. Calling it at us-central1 returns a 404 that looks
# like a permissions problem and is not one.
CINEMERIDIAN_GEMINI_LOCATION=us
# Set explicitly so this project does not depend on the machine-wide ADC quota
# project, which every local project using ADC shares.
GOOGLE_CLOUD_QUOTA_PROJECT=your-project-id

# --- ClickHouse Cloud ------------------------------------------------------
# Consumed only as the environment passed to the mcp-clickhouse subprocess.
# The application itself never opens a ClickHouse connection.
CLICKHOUSE_HOST=xxxxxxxx.us-central1.gcp.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=cinemeridian
